{
  "rules": [
    {
      "id": "@secretlint/secretlint-rule-preset-recommend"
    },
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "patterns": [
          {
            "name": "password",
            "patterns": [
              "/\\b[A-Z0-9_]*PASSWORD[A-Z0-9_]*\\b\\s*[:=]\\s*(?!process\\.env|import\\.meta\\.env|os\\.environ|\\$\\{|\\$[A-Z_])['\"]?(?<password>[^\\s'\"]{1,256})['\"]?/i",
              "/\"[A-Z0-9_]*PASSWORD[A-Z0-9_]*\"\\s*:\\s*(?!process\\.env|import\\.meta\\.env|os\\.environ|\\$\\{)\"(?<password>[^\"]{1,256})\"/i"
            ],
            "message": "Credenciais não podem ser commitadas com valor preenchido.  "
          },
          {
            "name": "secret",
            "patterns": [
              "/\\b[A-Z0-9_]*SECRET[A-Z0-9_]*\\b\\s*[:=]\\s*(?!process\\.env|import\\.meta\\.env|os\\.environ|\\$\\{|\\$[A-Z_])['\"]?(?<secret>[^\\s'\"]{1,256})['\"]?/i",
              "/\"[A-Z0-9_]*SECRET[A-Z0-9_]*\"\\s*:\\s*(?!process\\.env|import\\.meta\\.env|os\\.environ|\\$\\{)\"(?<secret>[^\"]{1,256})\"/i"
            ],
            "message": "Credenciais não podem ser commitadas com valor preenchido.  "
          },
          {
            "name": "key",
            "patterns": [
              "/\\b[A-Z0-9_]*KEY[A-Z0-9_]*\\b\\s*[:=]\\s*(?!process\\.env|import\\.meta\\.env|os\\.environ|\\$\\{|\\$[A-Z_])['\"]?(?<key>[^\\s'\"]{8,256})['\"]?/i",
              "/\"[A-Z0-9_]*KEY[A-Z0-9_]*\"\\s*:\\s*(?!process\\.env|import\\.meta\\.env|os\\.environ|\\$\\{)\"(?<key>[^\"]{8,256})\"/i"
            ],
            "message": "Credenciais não podem ser commitadas com valor preenchido.  "
          },
          {
            "name": "token",
            "patterns": [
              "/\\b[A-Z0-9_]*TOKEN[A-Z0-9_]*\\b\\s*[:=]\\s*(?!process\\.env|import\\.meta\\.env|os\\.environ|\\$\\{|\\$[A-Z_])['\"]?(?<token>[^\\s'\"]{8,256})['\"]?/i",
              "/\"[A-Z0-9_]*TOKEN[A-Z0-9_]*\"\\s*:\\s*(?!process\\.env|import\\.meta\\.env|os\\.environ|\\$\\{)\"(?<token>[^\"]{8,256})\"/i"
            ],
            "message": "Credenciais não podem ser commitadas com valor preenchido.  "
          },
          {
            "name": "AWS credentials",
            "patterns": [
              "/aws_access_key_id\\s*=\\s*\\S+/i",
              "/aws_secret_access_key\\s*=\\s*\\S+/i"
            ]
          },
          {
            "name": "private keys",
            "filePathGlobs": ["**/*.pem", "**/*.key"],
            "patterns": ["/BEGIN (RSA |EC )?PRIVATE KEY/"]
          }
        ]
      }
    }
  ]
}
